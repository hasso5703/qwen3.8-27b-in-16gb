# Pinned versions — the whole point of this repo.
# Every install gets EXACTLY these bits. Bump deliberately, test, tag a release.

# llama.cpp — commit validated on RTX 4070 Ti SUPER 16 GB, 2026-08-18
# (custom build: GGML_CUDA_FA_ALL_QUANTS=ON, required for K q8_0 / V q4_0 flash-attn kernels)
LLAMACPP_COMMIT=169e4a7ff201e666c2325bcd35afb64573e39d09
LLAMACPP_SHORT=169e4a7f
# Release tag on THIS repo that hosts the prebuilt binary (built by .github/workflows/build-llamacpp.yml)
BINARY_RELEASE_TAG=llamacpp-169e4a7f

# Model — pinned by Hugging Face snapshot revision + SHA256 of the GGUF
MODEL_REPO=empero-ai/Qwen3.8-27B-Ridge-GGUF
MODEL_REVISION=486faa5f2032ff99bdc8993ade1b8fff13d1464c
MODEL_FILE=Qwen3.8-27B-Ridge-3.7bpw.gguf
MODEL_SHA256=95580dbdaad579582ee898257116abc18d7f3625a00c16a15735d41444a09f5e
MODEL_SIZE_BYTES=12599187008

# Host requirements (the only thing we cannot pin — we gate it instead)
# Floor = CUDA 12.x minor-version-compatibility minimum (NVIDIA CUDA 12.8
# release notes, Table 2). Ubuntu 22.04's default 535 driver passes.
MIN_DRIVER_VERSION=525.60.13
RECOMMENDED_DRIVER_MAJOR=570  # full CUDA 12.8 feature support (Table 3); validated on 595.84

# Context profiles (see docs/WHY.md for the VRAM math)
CTX_HEADLESS=145408   # measured: 15 732 MiB / 16 376 MiB (215 MiB headroom), no desktop on the GPU
CTX_DESKTOP=92160     # computed estimate: leaves ~800 MiB for Xorg/Wayland compositor — see WHY.md
